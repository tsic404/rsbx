#!/bin/sh
# read returns non-zero at end of file, so the value comes from the variable.
p1=""
IFS= read -r p1 < /proc/1/comm 2>/dev/null
echo "CLAUDE-INIT=$p1"
[ "$1" = config-read ] && {
  f=/work/agent/claude/settings.json
  if [ -r "$f" ]; then IFS= read -r line < "$f"; echo "CLAUDE-CONFIG=[$line]";
  else echo "CLAUDE-CONFIG=[missing]"; fi
}
exit 0
