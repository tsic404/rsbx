# The client side of the mixed model: the release image plus the host CLIs that
# are supposed to run here. The release image carries the rsbx client and its
# helpers, and no git, which is exactly the client half this probe needs.
FROM rsbx:ci
COPY multica omp codex claude /usr/local/bin/
USER 0
RUN chmod 755 /usr/local/bin/multica /usr/local/bin/omp \
              /usr/local/bin/codex /usr/local/bin/claude && \
    test ! -e /usr/bin/git && test ! -e /bin/git
